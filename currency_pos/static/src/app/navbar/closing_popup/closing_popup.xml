<?xml version="1.0" encoding="UTF-8"?>
<!--
    Extends point_of_sale.ClosePosPopup of Odoo 20 (templates use `this.`):
    - the cash summary and the cash count input are repeated for every cash box
      (one cash payment method per currency), not only for the default cash;
    - amounts of foreign methods are shown in the currency of the method, and
      the counted amount of a foreign method is entered in that currency (the
      server reads `{payment_method_id: counted}` in the currency of the method).
-->
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-methods-overview')]/div[hasclass('w-100') and hasclass('mb-3')][1]" position="replace">
            <t t-if="this.pos.config.cash_control">
                <t t-foreach="this.getCashDetailsList()" t-as="cashDetails" t-key="cashDetails.id">
                    <t t-set="diff" t-value="this.getDifference(cashDetails.id)" />
                    <t t-set="counted" t-value="this.state.payments[cashDetails.id]?.counted || '0'" />
                    <t t-set="moveData" t-value="this.getCashMoveData(cashDetails)"/>
                    <div class="w-100 mb-3">
                        <div class="d-flex align-items-center justify-content-between fs-3">
                            <span t-out="cashDetails.name" />
                            <span t-out="this.formatClosingCashExpected(cashDetails)" />
                        </div>
                        <div class="d-flex align-items-center justify-content-between text-muted border-start ps-2">
                            <span>Opening</span>
                            <span t-out="this.formatClosingCashOpening(cashDetails)" />
                        </div>
                        <div t-if="cashDetails.payment_amount" class="d-flex align-items-center justify-content-between text-muted border-start ps-2">
                            <span>Payments in <t t-out="cashDetails.name"/></span>
                            <span class="align-top" t-out="this.formatClosingPaymentSubAmount(cashDetails)"/>
                        </div>
                        <PaymentMethodBreakdown title.translate="Cash In / Out" total_amount="moveData.total" transactions="moveData.moves"/>
                        <div class="d-flex align-items-center justify-content-between text-muted border-start ps-2">
                            <span>Counted</span>
                            <span t-out="this.formatClosingCountedDisplay(cashDetails, this.parseValidCounted(counted))" />
                        </div>
                        <div class="d-flex align-items-center justify-content-between text-muted border-start ps-2" t-att-class="{'text-danger fw-bold': diff}">
                            <span>Difference</span>
                            <span class="cash-difference" t-out="this.formatClosingDifferenceDisplay(cashDetails, cashDetails.id)" />
                        </div>
                    </div>
                </t>
            </t>
        </xpath>

        <xpath expr="//div[hasclass('payment-methods-overview')]//div[@t-foreach='this.props.non_cash_payment_methods']//div[hasclass('fs-3')]/span[2]" position="attributes">
            <attribute name="t-out">this.formatClosingPaymentAmount(pm)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('payment-methods-overview')]//div[@t-foreach='this.props.non_cash_payment_methods']//span[text()='Counted']/following-sibling::span[1]" position="attributes">
            <attribute name="t-out">this.formatClosingCountedDisplay(pm, counted)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('payment-methods-overview')]//div[@t-foreach='this.props.non_cash_payment_methods']//span[text()='Difference']/following-sibling::span[1]" position="attributes">
            <attribute name="t-out">this.formatClosingDifferenceDisplay(pm, pm.id)</attribute>
        </xpath>

        <xpath expr="//div[hasclass('cash-count-inputs')]/div[hasclass('col-12')][.//label[contains(., 'Cash Count')]]" position="replace">
            <t t-if="this.pos.config.cash_control">
                <t t-foreach="this.getCashDetailsList()" t-as="cashDetails" t-key="cashDetails.id">
                    <div class="col-12 col-md-6">
                        <label class="form-label">
                            <t t-out="cashDetails.name"/> Count
                        </label>
                        <div class="d-flex w-100 gap-2 mt-1">
                            <CashInput
                                class="'cash-input w-100'"
                                tModel="[this.state.payments[cashDetails.id], 'counted']"
                                currencySymbol="this.getCurrencySymbol(cashDetails)"
                                currencyPosition="this.getCurrencyPosition(cashDetails)"
                                isValid="(val) => this.pos.isValidFloat(val)"
                                onBlur="() => this.handleCashBoxCountBlur(cashDetails)"
                            />
                            <button class="icon oi btn btn-secondary" data-icon="payments"
                                t-on-click="() => this.openDetailsPopup(cashDetails)" />
                            <button class="icon oi btn btn-secondary" data-icon="content_copy"
                                t-on-click="() => this.autoFillCashCount(cashDetails)" />
                        </div>
                    </div>
                </t>
            </t>
        </xpath>
        <xpath expr="//t[@t-foreach='this.validPms']//CashInput" position="attributes">
            <attribute name="currencySymbol">this.getCurrencySymbol(pm)</attribute>
            <attribute name="currencyPosition">this.getCurrencyPosition(pm)</attribute>
        </xpath>
    </t>
</templates>
