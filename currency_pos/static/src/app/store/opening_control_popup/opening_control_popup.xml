<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OpeningControlPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('opening-cash-section')]" position="replace">
            <div class="opening-cash-section mb-3" t-if="this.cashMethodCount">
                <t t-foreach="this.getCashPaymentMethods()" t-as="cashMethod" t-key="cashMethod.id">
                    <label class="form-label">
                        Opening cash — <t t-out="this.formatOpeningCashLabel(cashMethod)"/>
                    </label>
                    <div t-att-class="{ 'w-50': !this.ui.isSmall }" class="cash-input-sub-section d-flex gap-1 mb-2">
                        <CashInput
                            class="'flex-grow-1'"
                            tModel="[this.state.openingCashByMethod, cashMethod.id]"
                            currencySymbol="this.getCurrencySymbol(cashMethod)"
                            currencyPosition="this.getCurrencyPosition(cashMethod)"
                            isValid="(val) => this.pos.isValidFloat(val)"
                            autofocus="cashMethod_index === 0"
                            placeholder="'Opening Balance Eg: 123'"
                            onBlur="() => this.handleMethodInputChange(cashMethod)"
                        />
                        <div class="button icon btn btn-secondary btn-lg lh-lg"
                            t-on-click="() => this.openDetailsPopup(cashMethod)">
                            <i class="oi" data-icon="payments" role="img" title="Open the money details popup"/>
                        </div>
                    </div>
                </t>
            </div>
        </xpath>
        <xpath expr="//button[hasclass('btn-primary')][@t-on-click='this.confirm']" position="attributes">
            <attribute name="t-att-disabled">!this.canConfirmOpening()</attribute>
        </xpath>
    </t>
</templates>
