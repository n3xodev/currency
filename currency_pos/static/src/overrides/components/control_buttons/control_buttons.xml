<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <!-- Odoo 20 renders the pricelist button through the controlButton template
             (`name="o_pricelist_button"`); add the exchange currency button after it. -->
        <xpath expr="//t[@name='o_pricelist_button']" position="after">
            <t t-call="point_of_sale.controlButton"
                icon="'swap_horiz'"
                btnText="this.exchangeCurrency ? this.exchangeCurrency.name : 'Moneda'"
                btnClasses="'btn-secondary '"
                onClick="() => this.clickExchangeCurrency()"/>
        </xpath>
    </t>
</templates>
